# Turns files into C arrays: cmake -DOUT=x.c -DINPUTS="name=path;name=path" -P Embed.cmake
# Each becomes `const char <name>[]` (NUL-terminated) and `const size_t <name>_len`.
# Used by apps/web to compile its assets in (no file system serving, architecture 13.6).
set(_c "/* Generated by cmake/Embed.cmake. Do not edit. */\n#include <stddef.h>\n")
foreach(pair IN LISTS INPUTS)
  string(REPLACE "=" ";" kv "${pair}")
  list(GET kv 0 name)
  list(GET kv 1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR len "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
  string(APPEND _c "extern const char ${name}[];\nextern const size_t ${name}_len;\n"
    "const char ${name}[] = {\n${bytes}0};\nconst size_t ${name}_len = ${len};\n")
endforeach()
file(WRITE "${OUT}.tmp" "${_c}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
